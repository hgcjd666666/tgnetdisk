# Telegram 应用凭证（my.telegram.org 申请，2040 是官方桌面端）
TG_API_ID=2040
TG_API_HASH=b18441a1ff607e10a989891a5462e627

# 登录后的 StringSession 字符串，或 .session 文件路径
TG_SESSION=

# 存储用的频道/群 id，账号必须是管理员。留空会自动找/建一个叫 tgnd 的私有群
TG_CHAT=

# WebDAV
PORT=8090
DAV_BIND=0.0.0.0
DAV_USER=admin
DAV_PASS=changeme

# 只读模式：PUT/DELETE/MKCOL/MOVE/COPY/PROPPATCH 一律 403
DAV_READONLY=0

# 分片大小（MB）。上限由 TG 的 4000 part × 512KB 决定，别超过 2047
SLICE_MB=2000

# 单个分片内部的并发块数
UPLOAD_WORKERS=2
UPLOAD_PART_KB=512
# 后台同时上传几个文件
UPLOAD_QUEUE_WORKERS=1

# 索引库位置（默认脚本目录下 tgnd.db）
TGND_DB=
# 缓存目录（默认脚本目录下 cache/）
TGND_CACHE=

# 本地缓存总上限（GB）。0 = 不限制
CACHE_MAX_GB=16

# 有改动且空闲这么多秒后，把索引压成快照推到 TG
SNAPSHOT_SEC=10

# 同时在吐字节的下载响应上限，超了回 503
MAX_STREAMS=64
# 单个目录 PROPFIND 最多列多少条，超了回 507
PROPFIND_MAX_ENTRIES=50000

# 环形日志（定长，写满覆盖）与追加日志
TGND_LOG=
TGND_LOG_MAX=1048576
TGND_LOG_APPEND=
