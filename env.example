# Telegram 应用凭证（my.telegram.org 申请，这里 2040 是官方桌面端）
TG_API_ID=2040
TG_API_HASH=b18441a1ff607e10a989891a5462e627

# 登录后的 StringSession 字符串，或 .session 文件路径
TG_SESSION=

# 存储用的频道/群 id，账号必须是管理员
TG_CHAT=

# 设备名，多节点各用各的（同一个 session 不能两地同时用）
TG_DEVICE=tgnd

# WebDAV
PORT=8090
DAV_USER=admin
DAV_PASS=changeme

# 分片大小（MB）。上限由 TG 的 4000 part × 512KB 决定，2000MB 正好卡线
SLICE_MB=2000

# 可选 HTTP 代理，如 http://127.0.0.1:7890
TG_PROXY=

# 设为 0 只跑命令行，不启动 WebDAV（配合 systemctl stop tgnetdisk 用）
WEBDAV=1

# 索引写锁：
#   none —— 单设备（默认）：不锁。同机的 server 与 cli 共用同一个 sqlite 文件，
#           WAL 已经把并发写串起来了，写操作毫秒级返回，不产生任何 TG 往返
#   tg   —— 多设备：锁挂在 TG 置顶快照的 caption 上，写前抢、写完推快照并放锁。
#           锁存在的唯一理由就是防止别的设备同时改索引（两个节点各推各的快照，
#           后推的会整库覆盖先推的），只有一台设备在写时不需要
TGND_LOCK=none

# 单机模式：设为 0 时连 caption 都不写，适合完全离线/测试
ONLINE=1

# 后台备份：本地有改动、且空闲这么多秒之后，才把索引压成快照推上 TG。
# 连写 100 个文件也只会在写完安静下来后推一次，没有新改动就不重复上传。
SNAPSHOT_SEC=10

# TG 上保留最近几份快照。>1 时每次新发一条消息（旧的自动删），推错了能回滚。
# 单设备模式下 snapshot 是「备份」，留 3 份最稳；tg 模式强制只留 1 份（锁挂在上面）。
SNAPSHOT_KEEP=3

# WebDAV 监听地址。只有本机/隧道访问时建议改成 127.0.0.1
DAV_BIND=0.0.0.0

# 同时在吐字节的下载/响应上限，超了回 503（防几十个并发 Range 把上传/补洞饿死）
MAX_STREAMS=64

# 单个集合 PROPFIND / 目录页最多列多少条，超了回 507
PROPFIND_MAX_ENTRIES=50000

# 本地读缓存上限（GB）。0 = 关闭（默认）。>0 时读过的文件留一份在 cache/blobs/，
# 再次读同一份内容直接走本地盘；超限按 LRU 删最旧的。目录可用 TGND_CACHE 另指。
CACHE_MAX_GB=0

# 后台上传并发路数（PUT 落盘即返回，字节由这些 worker 送上去）
UPLOAD_QUEUE_WORKERS=1

# tgnd get 命中缓存时，大于这个尺寸（MB）才硬链接，小文件直接复制
GET_LINK_MIN_MB=16

# Range 请求之后的补洞速率上限（KB/s）。有客户端正在读时自动降到 1/8。
# 设 0 关闭「边看边缓存」。
FILL_RATE_KB=2048

# 上传完成后把字节直接留作本地读缓存（同盘 rename，零拷贝）。默认开。
# 关掉的话刚传完的文件第一次读还要从 TG 下载。
TGND_CACHE_ADOPT=1
