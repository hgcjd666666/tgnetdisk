# Telegram 应用凭证（my.telegram.org 申请，这里 2040 是官方桌面端）
TG_API_ID=2040
TG_API_HASH=b18441a1ff607e10a989891a5462e627

# 登录后的 StringSession 字符串，或 .session 文件路径
TG_SESSION=

# 存储用的频道/群 id，账号必须是管理员
TG_CHAT=

# 设备名，多节点各用各的（同一个 session 不能两地同时用）
TG_DEVICE=tgnd

# WebDAV
PORT=8090
DAV_USER=admin
DAV_PASS=changeme

# 分片大小（MB）。2047 是 2GB 内的安全上限
SLICE_MB=2047

# 可选 HTTP 代理，如 http://127.0.0.1:7890
TG_PROXY=
